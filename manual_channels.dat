# manual_channels.dat
#
# Decay channels PDG does not quantify, for species that matter thermally
# at T ~ 155 MeV. Charge splits are Clebsch-Gordan (exact); mode ratios and
# the choice of which modes saturate the width are modelling decisions,
# stated per entry. Channels closed at the pole are dropped and the
# remainder renormalized.
#
# Format matches the decay-list channel row:
#   id  n_daughters  BR  d1 d2 d3 d4 d5

# f_0(500)0 (9000221) -- f0(500)/sigma: PDG 'seen' only. m=0.475 GeV per decays_*_isofix_sigma.dat.
9000221	2	0.666667	-211	211	0	0	0	# pi- pi+
9000221	2	0.333333	111	111	0	0	0	# pi0 pi0

# f_0(980)0 (9010221) -- f0(980): PDG 'seen'. pi-pi : K-Kbar = 0.93:0.07 inherited from the tracked table.
9010221	2	0.620000	-211	211	0	0	0	# pi- pi+
9010221	2	0.310000	111	111	0	0	0	# pi0 pi0
9010221	2	0.070000	-321	321	0	0	0	# K- K+

# a_0(980)+ (9000211) -- a0(980): PDG 'seen'. eta pi taken to saturate; K Kbar omitted (at threshold).
9000211	2	1.000000	211	221	0	0	0	# pi+ eta

# a_0(980)- (-9000211) -- charge conjugate
-9000211	2	1.000000	-211	221	0	0	0	# pi- eta

# a_0(980)0 (9000111) -- a0(980)0
9000111	2	1.000000	111	221	0	0	0	# pi0 eta

# K_0^*(700)+ (9000321) -- K0*(700)/kappa: PDG 'seen'. K pi is the only open mode.
9000321	2	0.666667	211	311	0	0	0	# pi+ K0
9000321	2	0.333333	111	321	0	0	0	# pi0 K+

# K_0^*(700)- (-9000321) -- charge conjugate
-9000321	2	0.666667	-211	-311	0	0	0	# pi- Kbar0
-9000321	2	0.333333	111	-321	0	0	0	# pi0 K-

# K_0^*(700)0 (9000311) -- K0*(700)0
9000311	2	0.666667	-211	321	0	0	0	# pi- K+
9000311	2	0.333333	111	311	0	0	0	# pi0 K0

# Kbar_0^*(700)0 (-9000311) -- charge conjugate
-9000311	2	0.666667	211	-321	0	0	0	# pi+ K-
-9000311	2	0.333333	111	-311	0	0	0	# pi0 Kbar0

# K^*(892)+ (323) -- K*(892): PDG writes the mode as '(K pi)+-', item_type T (text) -> unparseable.
323	2	0.666667	211	311	0	0	0	# pi+ K0
323	2	0.333333	111	321	0	0	0	# pi0 K+

# K^*(892)- (-323) -- charge conjugate
-323	2	0.666667	-211	-311	0	0	0	# pi- Kbar0
-323	2	0.333333	111	-321	0	0	0	# pi0 K-

# K^*(892)0 (313) -- K*(892)0
313	2	0.666667	-211	321	0	0	0	# pi- K+
313	2	0.333333	111	311	0	0	0	# pi0 K0

# Kbar^*(892)0 (-313) -- charge conjugate
-313	2	0.666667	211	-321	0	0	0	# pi+ K-
-313	2	0.333333	111	-311	0	0	0	# pi0 Kbar0

# b_1(1235)+ (10213) -- b1(1235): PDG 'seen'. omega pi dominant.
10213	2	1.000000	211	223	0	0	0	# pi+ omega(782)0

# b_1(1235)- (-10213) -- charge conjugate
-10213	2	1.000000	-211	223	0	0	0	# pi- omega(782)0

# b_1(1235)0 (10113) -- b1(1235)0
10113	2	1.000000	111	223	0	0	0	# pi0 omega(782)0

# a_1(1260)+ (20213) -- a1(1260): PDG 'seen' for every mode. rho pi, S- and D-wave combined.
20213	2	0.500000	111	213	0	0	0	# pi0 rho(770)+
20213	2	0.500000	113	211	0	0	0	# rho(770)0 pi+

# a_1(1260)- (-20213) -- charge conjugate
-20213	2	0.500000	111	-213	0	0	0	# pi0 rho(770)-
-20213	2	0.500000	113	-211	0	0	0	# rho(770)0 pi-

# a_1(1260)0 (20113) -- a1(1260)0
20113	2	0.500000	-211	213	0	0	0	# pi- rho(770)+
20113	2	0.500000	-213	211	0	0	0	# rho(770)- pi+

# h_1(1170)0 (10223) -- h1(1170): PDG 'seen'. rho pi dominant.
10223	2	0.333333	-211	213	0	0	0	# pi- rho(770)+
10223	2	0.333333	111	113	0	0	0	# pi0 rho(770)0
10223	2	0.333333	-213	211	0	0	0	# rho(770)- pi+

# rho(770)+ (213) -- rho(770): PDG gives value_text '(~100)E-2', i.e. no measurement.
213	2	1.000000	111	211	0	0	0	# pi0 pi+

# rho(770)- (-213) -- charge conjugate
-213	2	1.000000	111	-211	0	0	0	# pi0 pi-

# rho(770)0 (113) -- rho(770)0: pi0 pi0 vanishes by Bose symmetry (CG is exactly zero).
113	2	1.000000	-211	211	0	0	0	# pi- pi+
